# 环境变量模板。复制为 .env.local(不会提交到 git)并按需修改:
#   cp .env.example .env.local
#
# Vite 约定:
#   .env                所有模式都加载
#   .env.development    bun run dev 时加载
#   .env.production     bun run build 时加载
#   .env.local          本地覆盖,优先级最高,已被 gitignore(*.local)
#
# 注意:只有 VITE_ 前缀的变量会暴露给客户端代码。

# 后端 API 地址(供 src/lib/api.ts 使用)
VITE_API_URL=http://localhost:3000
